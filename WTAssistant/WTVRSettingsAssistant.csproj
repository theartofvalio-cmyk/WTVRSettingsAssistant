<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <AssemblyName>WTVRSettingsAssistant</AssemblyName>
    <RootNamespace>WTVRSettingsAssistant</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Version>2.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="ThirdParty/vJoy/*">
      <Link>Drivers/vJoy/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Compile Remove="verification/**/*.cs" />
    <EmbeddedResource Include="Assets/*.png;Assets/*.wav;Icon.ico" />
    <Content Include="ThirdParty/XRNeckSafer/XR_APILAYER_NOVENDOR_XRNeckSafer.dll">
      <Link>NeckAssist/OpenXR/XR_APILAYER_NOVENDOR_XRNeckSafer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="ThirdParty/XRNeckSafer/XR_APILAYER_NOVENDOR_XRNeckSafer.json">
      <Link>NeckAssist/OpenXR/XR_APILAYER_NOVENDOR_XRNeckSafer.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="ThirdParty/XRNeckSafer/LICENSE-XRNeckSafer.txt">
      <Link>NeckAssist/OpenXR/LICENSE-XRNeckSafer.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <ProjectReference Include="../Modules/VTrim/Integration/VTrim/VTrim.Embedded.csproj" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <Target Name="RemoveNativeVJoyCompileReference" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(Filename)%(Extension)' == 'vJoyInterface.dll'" />
    </ItemGroup>
  </Target>
</Project>

