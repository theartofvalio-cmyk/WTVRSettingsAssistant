<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <AssemblyName>WTVRSettingsAssistant</AssemblyName>
    <RootNamespace>WTVRSettingsAssistant</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Version>2.0.4</Version>
    <AssemblyVersion>2.0.4.0</AssemblyVersion>
    <FileVersion>2.0.4.0</FileVersion>
    <!-- Keep Visual Studio / dotnet build output small. The release publish script
         supplies win-x86 + self-contained explicitly and creates a single-file app. -->
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="ThirdParty/vJoy/*">
      <Link>Drivers/vJoy/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>

    <Content Include="../Modules/VTrim/Integration/VTrim/Native/x86/vJoyInterface.dll">
      <Link>vJoyInterface.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Compile Remove="verification/**/*.cs" />
    <EmbeddedResource Include="Assets/**/*.png;Assets/**/*.wav;Assets/**/*.ico;Icon.ico" />
    <Content Include="ThirdParty/XRNeckSafer/NeckAssistant.dll">
      <Link>NeckAssistant.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="ThirdParty/XRNeckSafer/NeckAssistant.json">
      <Link>Drivers/NeckAssistant.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="ThirdParty/XRNeckSafer/LICENSE-XRNeckSafer.txt">
      <Link>Licenses/XRNeckSafer/LICENSE-XRNeckSafer.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <ProjectReference Include="../Modules/VTrim/Integration/VTrim/VTrim.Embedded.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <Target Name="RemoveNativeVJoyCompileReference" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(Filename)%(Extension)' == 'vJoyInterface.dll'" />
    </ItemGroup>
  </Target>

  <!-- WebView2 ships both WinForms and WPF wrappers. This application is
       WinForms-only; remove the unused WPF wrapper before RAR so it cannot
       introduce the WindowsBase 4.0/5.0 MSB3277 conflict. -->
  <Target Name="RemoveUnusedWebView2WpfReference"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(UseWPF)' != 'true'">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveUnusedWebView2WpfCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
