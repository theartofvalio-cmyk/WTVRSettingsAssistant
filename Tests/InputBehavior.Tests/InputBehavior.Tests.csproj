<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../WTAssistant/WTVRSettingsAssistant.csproj" /></ItemGroup>
  <Target Name="RemoveNativeVJoyCompileReference" AfterTargets="ResolvePackageAssets">
    <ItemGroup><ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(Filename)%(Extension)' == 'vJoyInterface.dll'" /></ItemGroup>
  </Target>
</Project>
