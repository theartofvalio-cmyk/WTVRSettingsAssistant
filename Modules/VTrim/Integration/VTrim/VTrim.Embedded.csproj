<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>VTrim.Embedded</AssemblyName>
    <RootNamespace>HOTASTrimUtility</RootNamespace>
    <Version>2.1</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <DefineConstants>$(DefineConstants);VTRIM_EMBEDDED</DefineConstants>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LateralAssistController.cs" />
    <EmbeddedResource Include="Assets/**/*.png;Assets/Aircraft/aircraft-index.json" />
    <Compile Include="ScrollPagePanel.cs" />
    <Compile Include="AircraftDatabase.cs;CompactAircraftStripLayout.cs;Form1.AircraftProfiles.cs;Form1.ProfileCards.cs;Form1.GlobalAxes.cs;Form1.AircraftControlEditor.cs" />
    <Compile Include="Form1.cs;VTrimTranslations.cs;VTrimTranslations.Release21.cs;Form1.Curves.cs;Form1.Instructor.cs;Form1.VirtualOutput.cs;Form1.Embedded.cs;VirtualOutput.cs;AxisResponse.cs;InstructorController.cs;NativeVJoy.cs;VJoyNativeResolver.cs;AircraftIcons.cs;GameWindow.cs;VJoySetup.cs;StoreTrimController.cs;WarThunderTelemetry.cs;VTrimSelfTest.cs;XInputGamepad.cs" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>
  <Target Name="RemoveNativeVJoyCompileReference" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)"
        Condition="'%(Filename)%(Extension)' == 'vJoyInterface.dll'" />
    </ItemGroup>
  </Target>
</Project>
